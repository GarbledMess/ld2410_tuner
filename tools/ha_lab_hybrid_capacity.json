{
  "profile": {
    "memory_mib": 2048,
    "vcpus": 2,
    "container_cpus": 0.5,
    "container_memory_mib": 1536,
    "disk_gib": 24,
    "port": 0
  },
  "source_paths": [
    "custom_components",
    "tests/hybrid_scaling.py",
    "tests/lab/hybrid_capacity_checks.py"
  ],
  "domains": ["ld2410_tuner"],
  "command_timeout": 3600,
  "commands": {
    "limits": "chroot /work/os docker exec ha-lab python3 /lab/scripts/limits_check.py",
    "hybrid_capacity": "chroot /work/os docker exec ha-lab python3 /workspace/project/tests/lab/hybrid_capacity_checks.py --output /config/lab-reports/hybrid-capacity.json"
  }
}
